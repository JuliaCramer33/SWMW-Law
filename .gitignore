# WordPress content ignores
#
# Ignores files and folders that are typically generated by WordPress or users,
# and should not be in version control.

# User uploads
/uploads/

# Other generated folders
/upgrade/
/upgrade-temp-backup/
/blogs.dir/

# Default plugins and themes
/plugins/hello.php
/themes/twenty*/
/themes/twentytwentyfive/


# Troubleshooting mode plugin
/mu-plugins/health-check-troubleshooting-mode.php

# Ignore specific plugins (e.g. paid plugins you install manually)
# Add any other plugins you don't want in the repo here.
/plugins/advanced-custom-fields-pro/
/plugins/fakerpress/

# SASS, Node build files
/themes/swmw-law/node_modules/
/themes/swmw-law/.sass-cache/
/themes/swmw-law/assets/css/style.css.map

# Logs and Backups
/debug.log
/*.log
/*.sql
/*.swo
/*.swp
/*.zip
/*.rar
/*.tar
/*.gz

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# WP Engine specific files
.wpe-content/
.wpe-config.json
.wpengine-support.json
.wpe-pso.json
.wpe-pso.php
/mu-plugins/wpengine-common/
_wpe_local_puid.json
