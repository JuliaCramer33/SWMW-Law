{
  "name": "swmw-law",
  "version": "1.0.0",
  "description": "SWMW Law WordPress Theme",
  "scripts": {
    "build": "wp-scripts build",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses",
    "format": "wp-scripts format",
    "format:css": "wp-scripts format-style",
    "format:js": "wp-scripts format-js",
    "format:php": "wp-scripts format-php",
    "lint": "npm run lint:css && npm run lint:js && npm run lint:php",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "lint:php": "wp-scripts lint-php",
    "lint:md:docs": "wp-scripts lint-md-docs",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "packages-update": "wp-scripts packages-update",
    "start": "wp-scripts start",
    "test": "wp-scripts test-unit-js",
    "test:e2e": "wp-scripts test-e2e",
    "test:unit": "wp-scripts test-unit-php"
  },
  "dependencies": {
    "@wordpress/scripts": "^26.0.0",
    "jquery": "^3.6.0"
  },
  "devDependencies": {
    "@wordpress/env": "^8.0.0",
    "@wordpress/eslint-plugin": "^14.0.0",
    "@wordpress/stylelint-config": "^21.0.0",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^9.1.0",
    "browser-sync": "^2.29.0",
    "browser-sync-webpack-plugin": "^2.3.0",
    "css-loader": "^6.7.0",
    "cssnano": "^6.1.2",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.0.0",
    "eslint-plugin-prettier": "^4.0.0",
    "mini-css-extract-plugin": "^2.7.0",
    "postcss": "^8.5.5",
    "postcss-cli": "^10.0.0",
    "postcss-loader": "^7.3.4",
    "prettier": "^2.0.0",
    "sass": "^1.89.2",
    "sass-loader": "^13.3.3",
    "style-loader": "^3.3.0",
    "stylelint": "^14.2.0",
    "stylelint-webpack-plugin": "^5.0.1",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  },
  "stylelint": {
    "extends": "@wordpress/stylelint-config",
    "rules": {
      "indentation": 2
    }
  }
}
