    "custom": {
      "responsive": {
        "mobile": {
          "name": "Mobile",
          "slug": "mobile",
          "media": "(max-width: 575px)"
        },
        "tablet": {
          "name": "Tablet",
          "slug": "tablet",
          "media": "(min-width: 576px) and (max-width: 991px)"
        },
        "desktop": {
          "name": "Desktop",
          "slug": "desktop",
          "media": "(min-width: 992px)"
        }
      }
    }
